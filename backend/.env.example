GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Firebase Admin SDK service account, used by the reminder push notification
# system. Either a file path on disk OR an inline JSON string. Set this on
# Render under Environment → Add Environment Variable. Never commit the JSON
# blob to the repository.
FIREBASE_SERVICE_ACCOUNT_JSON=
