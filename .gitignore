# ── Python ────────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
.env

# ── Dataset images (too large for GitHub, keep locally) ──────────────
DATA-RAW/
DATA-SPLIT/
DATA-LABEL/

# ── Trained model files (large .keras/.h5, keep locally) ─────────────
MODEL/*.keras
MODEL/*.h5
MODEL/backup/
MODEL/saved_model_tmp/
DETECTOR_MODEL/*.keras
DETECTOR_MODEL/*.h5

# ── Keep only the small TFLite files needed by the app ───────────────
# (tomoleafnet_v4.tflite, tomoleafnet_v4_cam.tflite, etc.)
# They are bundled in MOBILE_APP/assets/ — MODEL/ copies are local-only.

# ── macOS resource forks ─────────────────────────────────────────────
._*
.DS_Store

# ── IDE ──────────────────────────────────────────────────────────────
.idea/
*.iml

# ── Results (regenerated by training scripts) ────────────────────────
RESULTS/

# ── Misc ─────────────────────────────────────────────────────────────
*.tmp
*.log
